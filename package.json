{
  "name": "sela",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "node init.cjs && vite",
    "dev:website": "node init.cjs && vite --config vite.website.config.ts",
    "build": "node init.cjs && tsc -b && vite build",
    "build:website": "bun run og:generate && node init.cjs && tsc -b && vite build --config vite.website.config.ts",
    "preview:website": "vite preview --config vite.website.config.ts",
    "og:generate": "bun scripts/generate-og-image.mjs",
    "deploy:website": "node scripts/deploy-website.mjs",
    "release:manual": "node scripts/prepare-release.mjs --manual",
    "test:distribution": "node --test scripts/release-contract.check.mjs scripts/detect-application-changes.check.mjs scripts/auto-release.check.mjs",
    "lint": "oxlint",
    "format": "oxfmt \"src/**/*.{ts,tsx}\" \"website/src/**/*.{ts,tsx,css}\"",
    "format:check": "oxfmt --check \"src/**/*.{ts,tsx}\" \"website/src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build && bun run build:website",
    "preview": "vite preview",
    "prepare": "lefthook install",
    "tauri": "tauri"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-log": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8",
    "vitest": "^4.1.12",
    "wrangler": "^4.156.0"
  }
}
